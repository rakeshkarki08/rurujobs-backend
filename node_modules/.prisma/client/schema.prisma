generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  password        String?
  role            Role             @default(JOB_SEEKER)
  createdAt       DateTime         @default(now())
  jobsPosted      Job[]            @relation("EmployerJobs")
  applications    Application[]
  employeeProfile EmployeeProfile?
  employerProfile EmployerProfile?
}

model Job {
  id                String        @id @default(cuid())
  title             String // position
  company           String
  location          String // place
  salary            String
  type              String
  category          String // Legacy/fallback category
  categoryId        String?
  jobCategory       JobCategory?  @relation(fields: [categoryId], references: [id])
  description       String
  workDays          String?
  liveInOut         String?
  languageReq       String?
  nationalityPrefer String?
  employerId        String?
  employer          User?         @relation("EmployerJobs", fields: [employerId], references: [id])
  createdAt         DateTime      @default(now())
  applications      Application[]
}

model JobCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]
}

model Application {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  cvUrl     String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

enum Role {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

model EmployeeProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  firstName       String
  lastName        String
  phone           String
  username        String?
  workPermit      String
  address         String
  countryOfOrigin String
  jobTypeSearch   String
  experience      String
  liveInOutOption String
  resumes         String[] // Array of URLs
  photos          String[] // Array of URLs
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmployerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  firstName           String
  businessName        String?
  lastName            String
  address             String
  phone               String
  liveInOutOption     String
  previouslyContacted Boolean  @default(false)
  startDate           DateTime
  interviewTime       String?
  requirements        String   @db.Text
  agreedToTerms       Boolean  @default(false)
  logoUrl             String?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
